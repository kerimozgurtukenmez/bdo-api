{
    "name": "kerimozgurtukenmez/bdo-craft-api",
    "description": "Black Desert Online crafting calculator API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11"
    }
}
